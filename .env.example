# Unified DevOps Automation — Frontend Environment Variables
# Copy to .env.local to configure your local development environment.

# Base URL for the Express + Node.js Backend API
VITE_API_BASE_URL=http://localhost:5000/api

# Enable development mock mode (deterministic fixtures and stateful in-memory mock adapter)
# Set to 'false' to communicate with a live backend API server.
VITE_USE_MOCK_DATA=true

# SECURITY NOTICE:
# DO NOT place GitHub client secrets, Jenkins API tokens, GHCR tokens,
# Azure service principal credentials, or MongoDB connection strings here.
# All privileged secrets MUST reside on the Node.js/Express backend server.
